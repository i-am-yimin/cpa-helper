# Only send inputs consumed by Dockerfile to the builder.
**
!Dockerfile
!VERSION
!backend/
!backend/**
!frontend/
!frontend/**

**/.env
**/.env.*
**/.venv
**/__pycache__
**/.vite
**/.playwright-cli
**/node_modules
**/dist
**/build
**/bin
**/coverage
**/test-results
**/playwright-report
backend/local_migrations
backend/cpa-helper
backend/cpa-helper.exe
frontend/tests
**/*.test
**/*_test.go
**/*.test.*
**/*.spec.*
**/*.log
**/*.tsbuildinfo
