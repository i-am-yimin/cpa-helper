#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
[[ $EUID -eq 0 ]] || exit 77
source_repo=${1:?deployment source directory required}
runtime=/opt/actions-runner-ops-monitor
target=/opt/actions-runner-cpa-helper
user=cpadeploy
[[ -f $source_repo/deploy/cpa-helper-deploy ]] || exit 66
[[ -x $runtime/bin/Runner.Listener && -x $runtime/externals/node24/bin/node ]] || exit 69
version=$(env LD_LIBRARY_PATH="$runtime/lib" DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 "$runtime/bin/Runner.Listener" --version)
[[ $version == 2.338.0 ]] || { echo 'Review the existing runner runtime before installation.' >&2; exit 65; }
id "$user" >/dev/null 2>&1 || useradd --system --create-home --home-dir /var/lib/cpa-helper-runner --shell /sbin/nologin "$user"
install -o root -g root -m 0750 "$source_repo/deploy/cpa-helper-deploy" /usr/local/sbin/cpa-helper-deploy
rule=$(mktemp)
trap 'rm -f "$rule"' EXIT
printf '%s ALL=(root) NOPASSWD: /usr/local/sbin/cpa-helper-deploy *\n' "$user" > "$rule"
visudo -cf "$rule"
install -o root -g root -m 0440 "$rule" /etc/sudoers.d/cpa-helper-deploy
install -d -o "$user" -g "$user" -m 0755 "$target"
if [[ ! -f $target/.runner ]]; then
  IFS= read -r token
  [[ -n $token ]] || exit 78
  # Reuse only the already installed public runner distribution, never its
  # registration, credentials, work directory, environment, or service identity.
  cp -aL "$runtime/bin" "$target/"
  install -d -m 0755 "$target/externals/node24/bin" "$target/lib"
  install -m 0755 "$runtime/externals/node24/bin/node" "$target/externals/node24/bin/node"
  install -m 0644 "$runtime/lib/libstdc++.so.6" "$target/lib/libstdc++.so.6"
  for script in config.sh env.sh run.sh runsvc.sh safe_sleep.sh svc.sh; do
    install -m 0755 "$runtime/$script" "$target/$script"
  done
  chown -R "$user:$user" "$target"
  (
    cd "$target"
    runuser -u "$user" -- env LD_LIBRARY_PATH="$target/lib" DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \
      ./config.sh --url https://github.com/i-am-yimin/cpa-helper \
      --token "$token" --name rainyun-cpa-helper-deploy --labels cpa-helper-deploy \
      --work _work --unattended --disableupdate
  )
  unset token
fi
if [[ ! -f $target/.service ]]; then
  (cd "$target" && ./svc.sh install "$user")
fi
service=$(cat "$target/.service")
install -d -m 0755 "/etc/systemd/system/$service.d"
printf '[Service]\nEnvironment=LD_LIBRARY_PATH=%s/lib\nEnvironment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1\n' "$target" \
  > "/etc/systemd/system/$service.d/override.conf"
systemctl daemon-reload
systemctl enable --now "$service"
systemctl is-active --quiet "$service"
echo 'Repository-scoped CPA deployment runner is active.'
